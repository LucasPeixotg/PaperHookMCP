# Semantic Scholar Graph API.
# The token is optional — unauthenticated requests work at a lower rate limit.
SEMANTIC_SCHOLAR_API_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_TOKEN=

# OpenAlex API.
# The token is optional — a key only raises the daily request budget.
OPENALEX_API_BASE_URL=https://api.openalex.org
OPENALEX_API_TOKEN=

# Cross-encoder reranking of search candidates (src/services/models/reranker.py).
# The pool is the cost knob: one forward pass per candidate, capped at 50 by the
# OpenAlex semantic endpoint.
RERANK_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=40

# Per-paper disk cache (src/services/cache/paper_store.py), keyed by paper ID and DOI.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=2592000
CACHE_SIZE_LIMIT_MB=512
